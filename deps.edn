;; 2048-reframe-2 — Clojure CLI dependency manifest.
;;
;; re-frame2 is alpha and not on Clojars yet, so both the core and the
;; Reagent adapter are pulled directly from the github.com/day8/re-frame2
;; monorepo via :git/url + :git/sha + :deps/root. The two artefacts share
;; one SHA — pinning a single, named commit keeps the build reproducible
;; while we live on alpha.
;;
;; SHA pinned 2026-05-12 (worker session for bead reframe-2048-aja):
;;   399a58666e0cb8bcc5faa18f8d490ce8b80df802
;;   on day8/re-frame2 main (commit message: "fix(cofx): emit
;;   :rf.error/no-such-cofx trace instead of println for missing cofx
;;   (rf2-mq9o) (#346)" — 2026-05-11).
;;
;; To bump: replace the SHA in both :git/sha values below, then run
;;   clojure -P              ;; pre-resolve deps; surfaces breakage
;;   npx shadow-cljs compile app
;; before committing.
{;; shadow-cljs sources both the JVM classpath AND the CLJS source paths
 ;; from this file when shadow-cljs.edn carries `:deps {}` (which it does
 ;; — see shadow-cljs.edn). `src` and `test` therefore live here, not
 ;; in shadow-cljs.edn's :source-paths.
 :paths ["src" "test"]

 :deps  {org.clojure/clojure       {:mvn/version "1.11.1"}
         org.clojure/clojurescript {:mvn/version "1.11.132"}
         reagent/reagent           {:mvn/version "2.0.1"}

         ;; shadow-cljs needs to be on the classpath so `npx shadow-cljs`
         ;; can boot its `clojure.main` entrypoint. The npm package
         ;; supplies only the launcher; the JVM-side bits come from here.
         thheller/shadow-cljs      {:mvn/version "2.28.20"}

         ;; re-frame2 core (registry, drain, fx, trace).
         io.github.day8/re-frame2
         {:git/url   "https://github.com/day8/re-frame2.git"
          :git/sha   "399a58666e0cb8bcc5faa18f8d490ce8b80df802"
          :deps/root "implementation/core"}

         ;; re-frame2 Reagent adapter (mount + frame-provider context).
         ;;
         ;; The four sub-artefacts (reagent / schemas / machines /
         ;; future http) each declare `day8/re-frame2 {:local/root
         ;; "../../core"}` in their own deps.edn. With multiple gitlibs
         ;; checkouts that resolves to four distinct local-version
         ;; classpath entries, and clj's classpath builder rejects the
         ;; multi-version conflict ("No known ancestor relationship
         ;; between local versions for day8/re-frame2 ..."). The fix
         ;; is `:exclusions [day8/re-frame2]` on every sub-artefact
         ;; so they pick up the single top-level core/ checkout
         ;; (the `io.github.day8/re-frame2` entry above) by lib name.
         io.github.day8/re-frame2-reagent
         {:git/url    "https://github.com/day8/re-frame2.git"
          :git/sha    "399a58666e0cb8bcc5faa18f8d490ce8b80df802"
          :deps/root  "implementation/adapters/reagent"
          :exclusions [day8/re-frame2]}

         ;; re-frame2 schemas artefact (Malli-backed :spec validation
         ;; and reg-app-schema). Added by bead reframe-2048-z0b — the
         ;; impl-state layer attaches schemas to every event handler
         ;; and registers AppDb under reg-app-schema for dev-time
         ;; validation per spec §5.2.
         io.github.day8/re-frame2-schemas
         {:git/url    "https://github.com/day8/re-frame2.git"
          :git/sha    "399a58666e0cb8bcc5faa18f8d490ce8b80df802"
          :deps/root  "implementation/schemas"
          :exclusions [day8/re-frame2]}

         ;; re-frame2 state-machines artefact (reg-machine,
         ;; machine-transition, the :rf/machine framework sub).
         ;; Spec §4.8 says the game lifecycle MUST be a reg-machine.
         io.github.day8/re-frame2-machines
         {:git/url    "https://github.com/day8/re-frame2.git"
          :git/sha    "399a58666e0cb8bcc5faa18f8d490ce8b80df802"
          :deps/root  "implementation/machines"
          :exclusions [day8/re-frame2]}

         ;; re-frame2-epoch — Tool-Pair time-travel surface. Required
         ;; by re-frame2-story's scrubber (re-frame.story.ui.scrubber
         ;; :require's re-frame.epoch). Not a transitive dep of
         ;; re-frame2 core itself (per the Strategy-B per-feature
         ;; split documented in implementation/epoch/deps.edn) so we
         ;; have to add it explicitly here alongside the story dep.
         io.github.day8/re-frame2-epoch
         {:git/url    "https://github.com/day8/re-frame2.git"
          :git/sha    "399a58666e0cb8bcc5faa18f8d490ce8b80df802"
          :deps/root  "implementation/epoch"
          :exclusions [day8/re-frame2]}

         ;; re-frame2-story — Storybook-class component playground
         ;; for re-frame2. Per docs/guide/14-stories.md every variant
         ;; runs in its own frame against a fresh app-db; variant
         ;; bodies are plain data (no fn-slots). Hash-routing in
         ;; core.cljs gates `#/stories` -> mount-shell!. Production
         ;; bundles elide every reg-* body via the closure-define
         ;; `re-frame.story.config/enabled? false` set on the
         ;; :app build's :release map in shadow-cljs.edn.
         io.github.day8/re-frame2-story
         {:git/url    "https://github.com/day8/re-frame2.git"
          :git/sha    "399a58666e0cb8bcc5faa18f8d490ce8b80df802"
          :deps/root  "tools/story"
          :exclusions [day8/re-frame2]}

         ;; Malli — schema validation library re-frame2-schemas
         ;; delegates to by default. CLJS resolves malli.core/validate
         ;; at runtime, so the ns has to be required somewhere; we
         ;; do so in reframe-2048-2.schemas.
         metosin/malli            {:mvn/version "0.13.0"}}}
